# Local-only example values. Replace them in an ignored .env file.
MYSQL_DEV_PORT=3307
MYSQL_DEV_DATABASE=order_tracking_dev
MYSQL_DEV_USER=order_dev
MYSQL_DEV_PASSWORD=change-me-dev
MYSQL_DEV_ROOT_PASSWORD=change-me-dev-root

MYSQL_TEST_PORT=3308
MYSQL_TEST_DATABASE=order_tracking_test
MYSQL_TEST_USER=order_test
MYSQL_TEST_PASSWORD=change-me-test
MYSQL_TEST_ROOT_PASSWORD=change-me-test-root

ORDER_TRACKING_DATABASE_URL=mysql+pymysql://order_dev:change-me-dev@127.0.0.1:3307/order_tracking_dev?charset=utf8mb4
ORDER_TRACKING_TEST_DATABASE_URL=mysql+pymysql://order_test:change-me-test@127.0.0.1:3308/order_tracking_test?charset=utf8mb4
ORDER_TRACKING_APP_ENV=development

# S01 identity configuration. Keep real values only in ignored environment files.
ORDER_TRACKING_IDENTITY_TOKEN_SECRET=
ORDER_TRACKING_PHONE_ENCRYPTION_SECRET=
ORDER_TRACKING_PHONE_DIGEST_SECRET=
ORDER_TRACKING_FEISHU_IDENTITY_SCOPE=replace-with-tenant-and-app-scope
# Leave the next two values blank to reuse the S05 Feishu application credentials.
ORDER_TRACKING_FEISHU_IDENTITY_APP_ID=
ORDER_TRACKING_FEISHU_IDENTITY_APP_SECRET=
ORDER_TRACKING_FEISHU_IDENTITY_REDIRECT_URI=
# Set false only for local HTTP OAuth testing. Production must remain true.
ORDER_TRACKING_WEB_COOKIE_SECURE=true
# Normal development uses the real WeChat adapter only when both values are set.
ORDER_TRACKING_WECHAT_IDENTITY_APP_ID=
ORDER_TRACKING_WECHAT_IDENTITY_APP_SECRET=
# Used only as the disabled-adapter scope when real credentials are absent.
ORDER_TRACKING_WECHAT_IDENTITY_SCOPE=replace-with-wechat-appid-scope
# Keep false through deployment and migration. Enable only after the first real-send gate.
ORDER_TRACKING_WECHAT_NOTIFICATIONS_ENABLED=false
# Keep these disabled until each first real-send gate is approved.
ORDER_TRACKING_FEISHU_NOTIFICATIONS_ENABLED=false
ORDER_TRACKING_OPS_ALERTS_ENABLED=false
ORDER_TRACKING_WECHAT_NOTIFICATION_ADMIN_SHIPMENT_TEMPLATE_ID=qsM0bwEFQkMATPv-dPgwgtKw8XWdC8vJgfx5J8yqCNo
ORDER_TRACKING_WECHAT_NOTIFICATION_ADMIN_REPAIR_TEMPLATE_ID=gpFZ93n6vLFKUU5aCISc2CizJiCymGfKKTfl0e9HO6g
ORDER_TRACKING_WECHAT_NOTIFICATION_FACTORY_STATUS_TEMPLATE_ID=cSEC8Q5PUVz6NdcESpp-J4CGMLS8dScIK0CqsPRLzzY
ORDER_TRACKING_WECHAT_NOTIFICATION_FACTORY_DUE_TEMPLATE_ID=GHS9jvL74feBeckR1W-J-xD-udAgXbGpoHIjgSsnKLw
ORDER_TRACKING_WECHAT_NOTIFICATION_FACTORY_REPAIR_TEMPLATE_ID=gpFZ93n6vLFKUU5aCISc2CizJiCymGfKKTfl0e9HO6g
# Shared test uses trial; production uses formal.
ORDER_TRACKING_WECHAT_NOTIFICATION_MINIPROGRAM_STATE=formal
ORDER_TRACKING_AVATAR_BUCKET=replace-with-private-avatar-bucket
ORDER_TRACKING_PRODUCT_IMAGE_BUCKET=replace-with-private-product-image-bucket

# S05 Feishu Base order source. Keep real credentials only in ignored environment files.
ORDER_TRACKING_FEISHU_ORDER_APP_ID=
ORDER_TRACKING_FEISHU_ORDER_APP_SECRET=
ORDER_TRACKING_FEISHU_ORDER_APP_TOKEN=
ORDER_TRACKING_FEISHU_ORDER_TABLE_ID=
ORDER_TRACKING_FEISHU_ORDER_VIEW_ID=

# S06 private contract files. Keep credentials only in ignored environment files.
ORDER_TRACKING_PRIVATE_FILE_ENDPOINT=
ORDER_TRACKING_PRIVATE_FILE_ACCESS_KEY=
ORDER_TRACKING_PRIVATE_FILE_SECRET_KEY=
ORDER_TRACKING_PRIVATE_FILE_BUCKET=replace-with-private-contract-bucket
ORDER_TRACKING_PRIVATE_FILE_SECURE=true

# S12 direct 聚水潭新版 OpenAPI product query. Real credentials stay server-side only.
ORDER_TRACKING_JST_PRODUCT_ENDPOINT=https://openapi.jushuitan.com
ORDER_TRACKING_JST_PRODUCT_APP_KEY=
ORDER_TRACKING_JST_PRODUCT_APP_SECRET=
ORDER_TRACKING_JST_PRODUCT_TOKEN_CACHE_PATH=/tmp/order-tracking/jst-token.json
ORDER_TRACKING_JST_PRODUCT_INITIAL_SYNC_BEGIN=
ORDER_TRACKING_JST_PRODUCT_PAGE_SIZE=50

# S12 external notification targets. Use approved internal identities only.
ORDER_TRACKING_ADMIN_WEB_BASE_URL=
ORDER_TRACKING_OPS_ALERT_RECIPIENT_USER_ID=
