# 单独配置运维数据库账号和只允许 log-archives/v1/ 前缀的 OSS 凭据。
# 检索账号只授予数据库 SELECT、OSS GetObject 和 GetBucketAcl。
# 归档账号另外授予指定五表/清单表的必要 INSERT/UPDATE/DELETE 和 OSS PutObject/DeleteObject。
LOG_ARCHIVE_DATABASE_URL=mysql+pymysql://archive_user:replace-on-server@mysql:3306/order_tracking
LOG_ARCHIVE_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
LOG_ARCHIVE_OSS_REGION=cn-hangzhou
LOG_ARCHIVE_OSS_BUCKET=replace-with-private-bucket
LOG_ARCHIVE_OSS_ACCESS_KEY_ID=replace-on-server
LOG_ARCHIVE_OSS_ACCESS_KEY_SECRET=replace-on-server
