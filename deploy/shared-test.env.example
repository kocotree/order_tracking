# Copy to deploy/.env.shared-test on the server and chmod 600. Never commit real values.
ORDER_TRACKING_DEPLOY_VERSION=replace-with-ci-passed-commit
ORDER_TRACKING_HOST=order-tracking-test.kktree.cn
TRAEFIK_CERT_RESOLVER=myresolver

ORDER_TRACKING_APP_ENV=shared_test
ORDER_TRACKING_DATABASE_URL=mysql+pymysql://replace-with-test-user:replace-with-test-password@replace-with-test-db-host/order_tracking_test?charset=utf8mb4
ORDER_TRACKING_IDENTITY_TOKEN_SECRET=replace-with-random-secret
ORDER_TRACKING_PHONE_ENCRYPTION_SECRET=replace-with-random-secret
ORDER_TRACKING_PHONE_DIGEST_SECRET=replace-with-random-secret
ORDER_TRACKING_WEB_COOKIE_SECURE=true

ORDER_TRACKING_FEISHU_IDENTITY_APP_ID=replace-with-app-id
ORDER_TRACKING_FEISHU_IDENTITY_APP_SECRET=replace-with-app-secret
ORDER_TRACKING_FEISHU_IDENTITY_REDIRECT_URI=https://order-tracking-test.kktree.cn/api/v1/auth/feishu/callback
ORDER_TRACKING_FEISHU_ORDER_APP_ID=replace-with-app-id
ORDER_TRACKING_FEISHU_ORDER_APP_SECRET=replace-with-app-secret
ORDER_TRACKING_FEISHU_ORDER_APP_TOKEN=replace-with-base-token
ORDER_TRACKING_FEISHU_ORDER_TABLE_ID=replace-with-table-id
ORDER_TRACKING_FEISHU_ORDER_VIEW_ID=replace-with-view-id

ORDER_TRACKING_WECHAT_IDENTITY_APP_ID=replace-with-miniprogram-appid
ORDER_TRACKING_WECHAT_IDENTITY_APP_SECRET=replace-with-miniprogram-secret
ORDER_TRACKING_WECHAT_NOTIFICATION_ADMIN_SHIPMENT_TEMPLATE_ID=qsM0bwEFQkMATPv-dPgwgtKw8XWdC8vJgfx5J8yqCNo
ORDER_TRACKING_WECHAT_NOTIFICATION_ADMIN_REPAIR_TEMPLATE_ID=gpFZ93n6vLFKUU5aCISc2CizJiCymGfKKTfl0e9HO6g
ORDER_TRACKING_WECHAT_NOTIFICATION_FACTORY_STATUS_TEMPLATE_ID=cSEC8Q5PUVz6NdcESpp-J4CGMLS8dScIK0CqsPRLzzY
ORDER_TRACKING_WECHAT_NOTIFICATION_FACTORY_DUE_TEMPLATE_ID=GHS9jvL74feBeckR1W-J-xD-udAgXbGpoHIjgSsnKLw
ORDER_TRACKING_WECHAT_NOTIFICATION_FACTORY_REPAIR_TEMPLATE_ID=gpFZ93n6vLFKUU5aCISc2CizJiCymGfKKTfl0e9HO6g
ORDER_TRACKING_WECHAT_NOTIFICATION_MINIPROGRAM_STATE=trial
ORDER_TRACKING_WECHAT_NOTIFICATIONS_ENABLED=false

ORDER_TRACKING_PRIVATE_FILE_ENDPOINT=replace-with-private-minio-endpoint
ORDER_TRACKING_PRIVATE_FILE_ACCESS_KEY=replace-with-minimum-permission-access-key
ORDER_TRACKING_PRIVATE_FILE_SECRET_KEY=replace-with-minimum-permission-secret-key
ORDER_TRACKING_PRIVATE_FILE_SECURE=true
ORDER_TRACKING_PRIVATE_FILE_BUCKET=replace-with-test-contract-bucket
ORDER_TRACKING_AVATAR_BUCKET=replace-with-test-avatar-bucket
ORDER_TRACKING_PRODUCT_IMAGE_BUCKET=replace-with-test-product-image-bucket

ORDER_TRACKING_JST_PRODUCT_ENDPOINT=https://openapi.jushuitan.com
ORDER_TRACKING_JST_PRODUCT_APP_KEY=replace-with-app-key
ORDER_TRACKING_JST_PRODUCT_APP_SECRET=replace-with-app-secret
ORDER_TRACKING_JST_PRODUCT_TOKEN_CACHE_PATH=/var/lib/order-tracking/jst/token.json
ORDER_TRACKING_JST_PRODUCT_INITIAL_SYNC_BEGIN=2026-01-01T00:00:00+08:00
ORDER_TRACKING_JST_PRODUCT_PAGE_SIZE=50

ORDER_TRACKING_ADMIN_WEB_BASE_URL=https://order-tracking-test.kktree.cn
ORDER_TRACKING_FEISHU_NOTIFICATIONS_ENABLED=false
ORDER_TRACKING_OPS_ALERTS_ENABLED=false
ORDER_TRACKING_OPS_ALERT_RECIPIENT_USER_ID=replace-with-approved-test-user-id
