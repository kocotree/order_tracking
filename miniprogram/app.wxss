page {
  min-height: 100%;
  color: #1c2430;
  background: #f3f5f8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

view,
text,
button,
input,
image {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  padding: 0;
}
