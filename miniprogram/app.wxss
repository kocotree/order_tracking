.mini-expand-table{overflow:hidden;background:#fafbfd;border-top:1rpx solid #e3e7ec}.mini-expand-table-head,.mini-expand-table-row{display:grid;grid-template-columns:54rpx minmax(0,1.45fr) minmax(118rpx,1fr) 76rpx;align-items:center;column-gap:10rpx;padding:0 22rpx}.mini-expand-table-head{min-height:58rpx;color:#758190;font-size:19rpx;font-weight:700;background:#f4f6f8}.mini-expand-table-row{min-height:82rpx;border-top:1rpx solid #e5e9ee;font-size:21rpx}.mini-expand-table-row>text:first-child{text-align:center}.mini-expand-table-row>text:nth-child(2),.mini-expand-table-row>text:nth-child(3){min-width:0;overflow:hidden;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.mini-expand-table-row>text:nth-child(2){color:#27313d;font-weight:700}.mini-expand-table-row>text:nth-child(3){color:#657384}.mini-expand-table-head>text:last-child,.mini-expand-table-row>b{text-align:right}.mini-expand-table-row>b{color:#1267c9;font-size:22rpx;white-space:nowrap}

