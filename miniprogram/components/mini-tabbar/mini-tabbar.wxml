<view class="mini-tabbar-shell">
  <button
    wx:for="{{items}}"
    wx:key="key"
    class="mini-tabbar-item {{item.key === activeKey ? 'is-active' : ''}}"
    data-key="{{item.key}}"
    data-path="{{item.path}}"
    bindtap="openItem"
  >
    <image class="mini-tabbar-icon" src="{{item.key === activeKey && item.activeIcon ? item.activeIcon : item.icon}}" mode="aspectFit" />
    <text>{{item.label}}</text>
  </button>
</view>
