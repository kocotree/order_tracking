.titlebar-shell {
  position: relative;
  z-index: 20;
  padding: max(96rpx, env(safe-area-inset-top)) 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(225, 230, 237, 0.9);
  background: rgba(255, 255, 255, 0.96);
}

.titlebar-grid {
  display: grid;
  min-height: 84rpx;
  grid-template-columns: 176rpx 1fr 176rpx;
  align-items: center;
}

.titlebar-title {
  color: #15191e;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
}

.titlebar-back,
.titlebar-spacer {
  width: 76rpx;
  height: 76rpx;
}

.titlebar-back {
  justify-self: start;
  margin: 0;
  color: #15191e;
  font-size: 62rpx;
  font-weight: 300;
  line-height: 70rpx;
  background: transparent;
  transform: translateX(-28rpx);
}

.titlebar-back.is-left {
  transform: translateX(-28rpx);
}
