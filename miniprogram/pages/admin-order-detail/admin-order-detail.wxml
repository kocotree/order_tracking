<view class="order-mini-page"><mini-titlebar title="订单详情" showBack="{{true}}" bind:back="goBack" /><view wx:if="{{loading}}" class="mini-empty">正在加载订单…</view><view wx:elif="{{error}}" class="mini-empty mini-error">{{error}}</view><view wx:elif="{{order}}" class="mini-detail-content"><view class="mini-detail-hero"><view class="mini-card-head"><text>{{order.orderNo}}</text><text class="mini-status mini-status--{{statusTone}}">{{order.displayStatus}}</text></view><text class="mini-product-summary">{{productSummary}}</text><view class="mini-card-meta"><text>跟单人员 {{order.tracker}}</text><text>合同出货 {{order.contractShipDate}}</text></view></view><view class="mini-quantity-grid mini-detail-quantity"><view><text>{{totalText}}</text><text>订单数量</text></view><view><text>{{shippedText}}</text><text>已发数量</text></view><view><text>{{pendingText}}</text><text>未发数量</text></view></view><view class="mini-section"><view class="mini-section-title">订单明细</view><view wx:for="{{order.lines}}" wx:key="orderLineId" class="mini-line-row"><view><text>{{item.productName}}</text><text>{{item.propertiesValue}}</text></view><view><text>下单 {{item.orderQuantity}}</text><text>未发 {{item.pendingQuantity}}</text></view></view></view><view class="mini-section"><view class="mini-section-title">工厂进度</view><view wx:for="{{order.factoryProgress}}" wx:key="factoryId" class="mini-factory-row"><view class="mini-factory-head" data-id="{{item.factoryId}}" bindtap="toggleFactory"><text>{{item.factoryName}}</text><text>{{item.progressPercent}}% {{expandedFactory === item.factoryId ? '⌃' : '⌄'}}</text></view><view wx:if="{{expandedFactory === item.factoryId}}" class="mini-factory-body"><text>下单数量 {{item.orderQuantity}}</text><text>已发数量 {{item.shippedQuantity}}</text><text>未发数量 {{item.pendingQuantity}}</text></view></view></view></view></view>
