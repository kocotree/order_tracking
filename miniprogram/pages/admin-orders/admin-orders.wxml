<view class="order-mini-page">
  <mini-titlebar title="订单" />
  <view class="mini-search-bar"><view class="mini-search-field"><text>⌕</text><input value="{{keyword}}" placeholder="搜索订单编号或产品名称" bindinput="keywordChanged" confirm-type="search" bindconfirm="search" /></view><button bindtap="toggleFilter">筛选</button></view>
  <view wx:if="{{filterOpen}}" class="mini-filter-panel"><text>订单状态</text><view class="mini-status-options"><button data-status="all" bindtap="setStatus">全部</button><button data-status="未完成" bindtap="setStatus">未完成</button><button data-status="已逾期" bindtap="setStatus">已逾期</button><button data-status="已完成" bindtap="setStatus">已完成</button></view></view>
  <view class="mini-order-content">
    <view wx:if="{{loading}}" class="mini-empty">正在加载订单…</view><view wx:elif="{{error}}" class="mini-empty mini-error">{{error}}</view>
    <view wx:elif="{{!items.length}}" class="mini-empty"><text>暂无正式订单</text><text>{{previewMode ? '预览模式不读取业务数据' : '草稿不会显示在管理员小程序'}}</text></view>
    <view wx:else class="mini-order-list"><view wx:for="{{items}}" wx:key="orderId" class="mini-order-card" data-id="{{item.orderId}}" bindtap="openDetail"><view class="mini-card-head"><text>{{item.orderNo}}</text><text class="mini-status mini-status--{{item.statusTone}}">{{item.displayStatus}}</text></view><text class="mini-product-summary">{{item.productSummary}}</text><view class="mini-card-meta"><text>跟单人员 {{item.tracker}}</text><text>合同出货 {{item.contractShipDate}}</text></view><view class="mini-quantity-grid"><view><text>{{item.totalText}}</text><text>订单数量</text></view><view><text>{{item.shippedText}}</text><text>已发数量</text></view><view><text>{{item.pendingText}}</text><text>未发数量</text></view></view><view class="mini-progress"><view><view style="width: {{item.progressPercent}}%" /></view><text>{{item.progressPercent}}%</text></view></view></view>
  </view>
  <view class="mini-tabbar"><button class="is-active">订单</button><button bindtap="openProfile">我的</button></view>
</view>
