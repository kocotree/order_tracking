<view class="ship-detail-page"><mini-titlebar title="发货单详情" showBack="{{true}}" backLeft="{{true}}" bind:back="goBack"/><view wx:if="{{loading}}" class="mini-empty">正在加载发货单…</view><view wx:elif="{{shipment}}" class="ship-detail-content">
  <view class="ship-detail-hero"><view class="admin-ship-title"><text>{{shipment.shipmentNo}}</text><text wx:if="{{shipment.status === 'VOID_PENDING'}}" class="admin-ship-status">撤回处理中</text><text wx:elif="{{shipment.status === 'VOIDED'}}" class="admin-ship-status is-voided">已作废</text></view><text class="ship-factory-name">{{shipment.factoryName}}</text><view class="ship-detail-meta"><view><text>发货日期</text><b>{{shipment.businessDate}}</b></view><view><text>发货数量</text><b>{{shipment.totalQuantity}}</b></view><view><text>总箱数</text><b>{{shipment.totalBoxes}}</b></view></view></view>
  <view class="ship-card"><view class="ship-card-head"><text>发货明细</text><text>{{shipment.lines.length}} 个规格</text></view><view wx:for="{{lineGroups}}" wx:key="orderNo" class="ship-detail-group"><view role="button" class="ship-detail-summary" data-order-no="{{item.orderNo}}" bindtap="toggleLineGroup"><view><text>{{item.orderNo}}</text><text>{{item.items.length}} 个产品规格</text></view><b>合计 {{item.total}}</b><text class="detail-chevron {{item.expanded ? 'is-open' : ''}}">›</text></view><view wx:if="{{item.expanded}}" class="mini-expand-table"><view class="mini-expand-table-head"><text>序号</text><text>产品名称</text><text>颜色/规格</text><text>数量</text></view><view wx:for="{{item.items}}" wx:key="assignmentId" class="mini-expand-table-row"><text>{{index + 1}}</text><text>{{item.productName}}</text><text>{{item.propertiesValue}}</text><b>{{item.quantity}}</b></view></view></view></view>
  <view class="ship-card"><view class="ship-card-head"><text>装箱明细</text><text>共 {{shipment.totalBoxes}} 箱</text></view><view wx:for="{{boxGroups}}" wx:key="boxNo" class="ship-detail-group"><view role="button" class="ship-detail-summary" data-box-no="{{item.boxNo}}" bindtap="toggleBoxGroup"><view><text>箱号 {{item.boxNo}}</text><text>{{item.items.length}} 个产品规格</text></view><b>合计 {{item.total}}</b><text class="detail-chevron {{item.expanded ? 'is-open' : ''}}">›</text></view><view wx:if="{{item.expanded}}" class="mini-expand-table"><view class="mini-expand-table-head"><text>序号</text><text>产品名称</text><text>颜色/规格</text><text>数量</text></view><view wx:for="{{item.items}}" wx:key="assignmentId" class="mini-expand-table-row"><text>{{index + 1}}</text><text>{{item.productName}}　{{item.orderNo}}</text><text>{{item.propertiesValue}}</text><b>{{item.quantity}}</b></view></view></view></view>
  <view class="ship-card"><view class="ship-card-head"><text>发货凭证与工厂备注</text></view><view wx:if="{{proofs.length}}" class="ship-proof-grid"><button wx:for="{{proofs}}" wx:key="fileId" class="ship-proof {{item.status === 'failed' ? 'is-failed' : ''}}" data-file-id="{{item.fileId}}" bindtap="previewProof"><image wx:if="{{item.status === 'ready'}}" src="{{item.localPath}}" mode="aspectFill"/><text wx:elif="{{item.status === 'loading'}}">凭证加载中…</text><text wx:else>凭证加载失败，点击重试</text></button></view><view wx:else class="ship-empty">工厂未上传发货凭证</view><view class="ship-note">{{shipment.note || '—'}}</view></view><view class="ship-card"><view class="ship-card-head"><text>操作记录</text></view><view wx:for="{{shipment.returnEvents}}" wx:key="eventId" class="ship-log is-warning"><view class="ship-log-dot"/><view><b>按发货单退回</b><text>{{item.returnDate}} · {{item.reason}}</text></view></view><view wx:if="{{shipment.voidRequest}}" class="ship-log is-warning"><view class="ship-log-dot"/><view><b>提交撤回发货</b><text>{{shipment.voidRequest.reason}}</text><text wx:if="{{shipment.voidRequest.status === 'REJECTED'}}">审核结果：已拒绝　{{shipment.voidRequest.reviewComment}}</text><text wx:elif="{{shipment.voidRequest.status === 'APPROVED'}}">审核结果：已通过</text><text wx:else>等待管理员审核</text></view></view><view class="ship-log"><view class="ship-log-dot"/><view><b>提交发货单，发货记录立即生效</b><text>{{shipment.businessDate}} · {{shipment.factoryName}}工厂 · 工厂小程序</text></view></view></view>
</view></view>
