/* shared in app.wxss */
.ship-log {
  display: grid;
  grid-template-columns: 20rpx minmax(0, 1fr);
}

.ship-log .ship-log-dot {
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  margin-top: 5rpx;
  background: #1677ff;
  border: 4rpx solid #dcecff;
  border-radius: 50%;
}

.ship-log > view:last-child {
  display: grid;
  gap: 8rpx;
}
.admin-ship-title { display: flex; gap: 20rpx; align-items: center; justify-content: space-between; }
.ship-card-head text:only-child {
  color: #1c2430;
  font-size: 28rpx;
  font-weight: 800;
}
.admin-ship-status { padding: 8rpx 14rpx; color: #a45d00; font-size: 22rpx; font-weight: 750; background: #fff3dc; border-radius: 12rpx; }
.admin-ship-status.is-voided { color: #c62828; background: #fff0f0; }
.ship-log.is-warning .ship-log-dot { background: #f59e0b; border-color: #fff3dc; }
.ship-log + .ship-log { border-top: 1rpx solid #edf0f3; }
.ship-proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; padding: 26rpx 28rpx; }
.ship-proof { display: grid; height: 174rpx; padding: 0; place-items: center; overflow: hidden; color: #71808f; font-size: 20rpx; line-height: 1.45; background: #f8fafc; border: 1rpx solid #dce2e9; border-radius: 18rpx; }
.ship-proof image { width: 100%; height: 100%; }
.ship-proof.is-failed { padding: 18rpx; color: #c7393e; background: #fff5f5; border-color: #f0c7c9; }
