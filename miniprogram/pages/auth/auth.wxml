<view wx:if="{{mode === 'identifying'}}" class="auth-page auth-page--status">
  <view class="auth-orbit auth-orbit--one" />
  <view class="auth-orbit auth-orbit--two" />
  <view class="auth-brand"><text class="auth-brand-name">KOCOTREE</text><text>跟单管理系统</text></view>
  <view class="auth-card auth-card--status">
    <view class="auth-status-mark auth-status-mark--identifying">…</view>
    <text class="auth-eyebrow">管理员入口</text>
    <text class="auth-title">正在识别身份</text>
    <text class="auth-description">正在通过微信身份确认管理员账号，请稍候。</text>
    <text class="auth-note">身份识别完成后将自动进入下一步</text>
  </view>
</view>

<view wx:else class="auth-page auth-page--login">
  <view class="auth-leaf auth-leaf--top" />
  <view class="auth-leaf auth-leaf--bottom" />
  <view class="auth-login-main">
    <image class="auth-logo" src="/assets/logo-compact-ktk.svg" mode="aspectFit" />
    <view class="auth-copy"><text class="auth-title">跟单管理系统</text><text>查看订单、发货记录与返修进度</text></view>
    <button wx:if="{{agreementAccepted}}" class="auth-primary-button" loading="{{busy}}" open-type="getPhoneNumber" bindgetphonenumber="phoneAuthorized">
      <view class="auth-button-content">
        <view class="wechat-mark" aria-hidden="true">
          <view class="wechat-bubble wechat-bubble--back"><view class="wechat-eye"/><view class="wechat-eye"/></view>
          <view class="wechat-bubble wechat-bubble--front"><view class="wechat-eye"/><view class="wechat-eye"/></view>
        </view>
        <text>微信授权登录</text>
      </view>
    </button>
    <button wx:else class="auth-primary-button" bindtap="requestAgreement">
      <view class="auth-button-content">
        <view class="wechat-mark" aria-hidden="true">
          <view class="wechat-bubble wechat-bubble--back"><view class="wechat-eye"/><view class="wechat-eye"/></view>
          <view class="wechat-bubble wechat-bubble--front"><view class="wechat-eye"/><view class="wechat-eye"/></view>
        </view>
        <text>微信授权登录</text>
      </view>
    </button>
    <checkbox-group bindchange="agreementChanged">
      <label class="auth-agreement"><checkbox class="auth-checkbox" value="accepted" checked="{{agreementAccepted}}" color="#17664d"/><text>我已阅读并同意<text class="auth-link">用户协议</text>和<text class="auth-link">隐私政策</text></text></label>
    </checkbox-group>
  </view>
  <text class="auth-safe-note">仅用于已授权管理员访问业务数据</text>
</view>
