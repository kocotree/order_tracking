.auth-page {
  position: relative;
  display: flex;
  min-height: 100vh;
  overflow: hidden;
  flex-direction: column;
  color: #1c2430;
}

.auth-page--login {
  background: linear-gradient(180deg, #fcfefc 0%, #fbfdfc 62%, #f5faf4 100%);
}

.auth-leaf { position: absolute; z-index: 0; pointer-events: none; }
.auth-leaf--top { top: -150rpx; left: -180rpx; width: 560rpx; height: 560rpx; border-radius: 50%; background: #e1f0dc; opacity: .68; }
.auth-leaf--bottom { right: -190rpx; bottom: -250rpx; width: 1240rpx; height: 510rpx; border-radius: 50% 50% 0 0; background: linear-gradient(125deg, rgba(220,239,214,.82), rgba(243,249,239,.9)); transform: rotate(-5deg); }

.auth-login-main { position: relative; z-index: 1; display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 20rpx 68rpx 144rpx; text-align: center; }
.auth-logo { display: block; width: 300rpx; height: 200rpx; margin: 0 auto 48rpx; }
.auth-copy { display: flex; width: 100%; flex-direction: column; gap: 24rpx; margin-bottom: 92rpx; color: #626966; font-size: 28rpx; line-height: 1.7; }
.auth-copy .auth-title { color: #17664d; font-size: 60rpx; font-weight: 800; letter-spacing: 2rpx; line-height: 1.25; }
.auth-primary-button { display: flex; width: 100%; min-height: 104rpx; align-items: center; justify-content: center; color: #fff; font-size: 32rpx; font-weight: 800; line-height: normal; background: linear-gradient(135deg,#17684f,#126047); border-radius: 26rpx; box-shadow: 0 18rpx 40rpx rgba(18,96,71,.2); }
.auth-button-content { display: flex; align-items: center; justify-content: center; gap: 18rpx; }
.wechat-mark { position: relative; width: 52rpx; height: 42rpx; flex: 0 0 auto; }
.wechat-bubble { position: absolute; display: flex; align-items: flex-start; justify-content: center; gap: 8rpx; background: #fff; }
.wechat-bubble::after { position: absolute; width: 0; height: 0; border-style: solid; content: ""; }
.wechat-bubble--back { top: 0; left: 0; width: 34rpx; height: 29rpx; padding-top: 9rpx; border-radius: 50%; }
.wechat-bubble--back::after { bottom: -4rpx; left: 5rpx; border-width: 6rpx 5rpx 0 0; border-color: #fff transparent transparent; transform: rotate(18deg); }
.wechat-bubble--front { right: 0; bottom: 0; width: 31rpx; height: 26rpx; padding-top: 8rpx; border: 3rpx solid #17664d; border-radius: 50%; }
.wechat-bubble--front::after { right: 3rpx; bottom: -5rpx; border-width: 6rpx 0 0 5rpx; border-color: #fff transparent transparent; transform: rotate(-12deg); }
.wechat-eye { width: 4rpx; height: 4rpx; border-radius: 50%; background: #17664d; }
.auth-agreement { display: flex; align-items: flex-start; justify-content: center; gap: 8rpx; margin-top: 28rpx; color: #656d69; font-size: 20rpx; line-height: 1.55; }
.auth-checkbox { margin-top: -2rpx; transform: scale(.72); transform-origin: top right; }
.auth-link { color: #2b775e; }
.auth-safe-note { position: relative; z-index: 1; padding: 0 40rpx max(56rpx, env(safe-area-inset-bottom)); color: #737c77; font-size: 20rpx; text-align: center; }

.auth-page--status { padding: max(116rpx, calc(env(safe-area-inset-top) + 68rpx)) 48rpx max(56rpx, env(safe-area-inset-bottom)); background: linear-gradient(158deg,rgba(235,244,255,.96) 0%,#f8fafc 48%,#f4f6f8 100%); }
.auth-orbit { position: absolute; border: 1rpx solid rgba(22,119,255,.12); border-radius: 50%; }
.auth-orbit--one { top: -236rpx; right: -192rpx; width: 500rpx; height: 500rpx; box-shadow: 0 0 0 48rpx rgba(22,119,255,.03); }
.auth-orbit--two { bottom: 48rpx; left: -228rpx; width: 340rpx; height: 340rpx; }
.auth-brand { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 18rpx; color: #687586; font-size: 26rpx; font-weight: 600; letter-spacing: 8rpx; }
.auth-brand-name { color: #1677ff; font-size: 46rpx; font-weight: 800; letter-spacing: 8rpx; line-height: 1; }
.auth-card { position: relative; z-index: 1; display: flex; width: 100%; flex-direction: column; align-items: center; padding: 68rpx 48rpx 48rpx; margin: auto 0; border: 1rpx solid rgba(229,233,239,.86); border-radius: 44rpx; background: rgba(255,255,255,.94); box-shadow: 0 44rpx 112rpx rgba(32,58,91,.12); }
.auth-status-mark { display: grid; width: 116rpx; height: 116rpx; margin-bottom: 44rpx; place-items: center; color: #fff; font-size: 46rpx; font-weight: 800; background: #1677ff; border-radius: 36rpx; box-shadow: 0 24rpx 48rpx rgba(22,119,255,.25); }
.auth-eyebrow { margin-bottom: 16rpx; color: #1677ff; font-size: 24rpx; font-weight: 750; letter-spacing: 5rpx; }
.auth-card .auth-title { font-size: 48rpx; font-weight: 800; }
.auth-description { margin-top: 24rpx; color: #687586; font-size: 26rpx; line-height: 1.7; text-align: center; }
.auth-note { width: 100%; margin-top: 36rpx; padding: 24rpx; color: #1677ff; font-size: 24rpx; text-align: center; background: #eaf3ff; border-radius: 16rpx; }
