.preview-page { min-height: 100vh; background: #f3f5f1; }
.preview-content { padding: 32rpx 28rpx max(56rpx, env(safe-area-inset-bottom)); }
.preview-intro { display: flex; flex-direction: column; padding: 42rpx 38rpx; color: #fff; background: linear-gradient(145deg,#1e7258,#165c48); border-radius: 32rpx; box-shadow: 0 18rpx 42rpx rgba(25,101,78,.18); }
.preview-kicker { font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; opacity: .7; }
.preview-title { margin-top: 14rpx; font-size: 44rpx; font-weight: 800; }
.preview-description { margin-top: 16rpx; font-size: 25rpx; line-height: 1.65; opacity: .86; }
.preview-list { margin-top: 28rpx; overflow: hidden; background: #fff; border: 1rpx solid #e0e6df; border-radius: 28rpx; box-shadow: 0 12rpx 32rpx rgba(36,58,48,.06); }
.preview-item { display: flex; width: 100%; min-height: 116rpx; align-items: center; justify-content: space-between; padding: 24rpx 30rpx; line-height: normal; text-align: left; background: #fff; border-radius: 0; }
.preview-item::after { border: 0; border-bottom: 1rpx solid #e7ebe7; border-radius: 0; }
.preview-item:last-child::after { border-bottom: 0; }
.preview-item__copy { display: flex; min-width: 0; flex-direction: column; gap: 10rpx; }
.preview-item__label { color: #1e2924; font-size: 29rpx; font-weight: 800; }
.preview-item__description { color: #737d78; font-size: 23rpx; }
.preview-arrow { margin-left: 24rpx; color: #17664d; font-size: 44rpx; font-weight: 400; }
.preview-note { display: block; margin-top: 28rpx; color: #7b847f; font-size: 22rpx; text-align: center; }
