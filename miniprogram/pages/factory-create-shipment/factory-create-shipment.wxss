.ship-page { padding-bottom: calc(116rpx + env(safe-area-inset-bottom)); }
.ship-content { gap: 24rpx; padding: 24rpx 28rpx; }
.ship-card { border-radius: 28rpx; }
.ship-card-head { min-height: 92rpx; padding: 0 28rpx; }
.ship-card-head text:first-child { font-size: 30rpx; }
.ship-card-head text:only-child { color: #1c2430; }
.ship-card-body { padding: 26rpx 28rpx; }
.ship-box-form { padding-bottom: 26rpx; border-bottom: 1rpx solid #e3e7ec; }
.ship-box-summary image { width: 48rpx; height: 48rpx; flex: 0 0 48rpx; }
.ship-box-empty { display: grid; justify-items: center; padding: 38rpx 20rpx 20rpx; color: #8b96a3; text-align: center; }
.ship-box-empty image { width: 56rpx; height: 56rpx; margin-bottom: 12rpx; }
.ship-box-empty text:nth-child(2) { color: #4d5966; font-size: 25rpx; font-weight: 700; }
.ship-box-empty text:last-child { margin-top: 6rpx; font-size: 21rpx; }
.ship-box-strip { flex-wrap: nowrap; overflow-x: auto; }
.ship-box-switch { display: block; width: 100%; margin-top: 18rpx; white-space: nowrap; }
.ship-box-switch button { display: inline-grid; width: 108rpx; height: 96rpx; margin-right: 14rpx; vertical-align: top; }
.ship-box-switch button.is-current { color: #fff; background: #1677ff; border-color: #1677ff; box-shadow: 0 10rpx 24rpx rgba(22,119,255,.2); }
.ship-box-switch button.is-current text:last-child { color: rgba(255,255,255,.78); }
.ship-box-switch button.is-packed:not(.is-current) { color: #33815d; background: #f2faf6; border-color: #cfe7dc; }
.ship-current-summary { display: flex; min-height: 74rpx; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 0 20rpx; color: #5d6e81; background: #eaf3ff; border-radius: 16rpx; font-size: 22rpx; }
.ship-current-summary b { color: #1267c9; font-size: 28rpx; }
.ship-pack-form .ship-label:not(:first-child) { margin-top: 22rpx; }
.ship-picker { display: flex; align-items: center; justify-content: space-between; width: 100%; }
.ship-picker text { color: #6f7a87; font-size: 23rpx; }
.ship-availability { display: grid; grid-template-columns: repeat(3,1fr); margin: 20rpx 0 24rpx; padding: 18rpx 0; border-top: 1rpx solid #e3e7ec; border-bottom: 1rpx solid #e3e7ec; }
.ship-availability view { display: grid; gap: 4rpx; padding: 0 16rpx; border-left: 1rpx solid #e7ebf0; }
.ship-availability view:first-child { padding-left: 0; border-left: 0; }
.ship-availability text { color: #7a8491; font-size: 20rpx; }
.ship-availability b { color: #1c2430; font-size: 30rpx; }
.ship-availability b.is-remaining { color: #1677ff; }
.ship-pack-quantity { display: flex!important; align-items: center; grid-auto-flow: column; gap: 14rpx!important; }
.ship-pack-quantity text { color: #1677ff!important; font-size: 26rpx!important; }
.ship-pack-quantity button { width: 48rpx; height: 48rpx; color: #7f8a97; font-size: 30rpx; line-height: 48rpx; background: #edf1f5; border-radius: 50%; }
.ship-preview-overview { display: grid; grid-template-columns: repeat(2,1fr); overflow: hidden; background: linear-gradient(135deg,#f7fbff,#edf6ff); border: 1rpx solid #dbe6f3; border-radius: 28rpx; box-shadow: 0 10rpx 28rpx rgba(34,50,70,.06); }
.ship-preview-overview view { display: grid; gap: 8rpx; padding: 28rpx 24rpx; border-left: 1rpx solid #dce8f5; }
.ship-preview-overview view:first-child { border-left: 0; }
.ship-preview-overview text { color: #607288; font-size: 20rpx; }
.ship-preview-overview b { color: #1267c9; font-size: 44rpx; }
.ship-summary-row { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding: 0 28rpx; border-bottom: 1rpx solid #e3e7ec; }
.ship-summary-row:last-child { border-bottom: 0; }
.ship-summary-row > text { min-width: 0; overflow: hidden; font-size: 25rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.ship-summary-row view { display: flex; align-items: center; gap: 16rpx; }
.ship-summary-row b { color: #1267c9; font-size: 24rpx; white-space: nowrap; }
.ship-summary-row view text { color: #8c98a6; font-size: 32rpx; }
.ship-expand-group:not(:last-child) { border-bottom: 1rpx solid #e3e7ec; }
.ship-expand-group .ship-summary-row { border-bottom: 0; }
.ship-chevron { display: inline-block; transform: rotate(0); transition: transform .2s ease; }
.ship-chevron.is-open { transform: rotate(90deg); }
.ship-expand-body { padding: 0 28rpx 18rpx; background: #fbfcfd; }
.ship-expand-line { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 1rpx solid #e7ebef; }
.ship-expand-line > view { display: grid; min-width: 0; gap: 6rpx; }
.ship-expand-line text:first-child { overflow: hidden; color: #27313d; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.ship-expand-line text:last-child { color: #73808d; font-size: 20rpx; }
.ship-expand-line b { color: #1267c9; font-size: 23rpx; white-space: nowrap; }
.ship-preview-boxes { display: grid; gap: 12rpx; padding: 24rpx; }
.ship-preview-box { display: grid; grid-template-columns: 62rpx minmax(0,1fr) auto 24rpx; min-height: 108rpx; align-items: center; gap: 18rpx; padding: 16rpx 20rpx; background: #fbfcfd; border: 1rpx solid #e2e7ed; border-radius: 22rpx; }
.ship-preview-box image { width: 62rpx; height: 62rpx; padding: 14rpx; background: #eaf3ff; border-radius: 18rpx; }
.ship-preview-box > view { display: grid; gap: 4rpx; }
.ship-preview-box > view text:first-child { font-size: 25rpx; font-weight: 750; }
.ship-preview-box > view text:last-child { color: #7b8694; font-size: 20rpx; }
.ship-preview-box b { color: #1267c9; font-size: 24rpx; white-space: nowrap; }
.ship-preview-box > text { color: #8c98a6; font-size: 32rpx; }
.ship-preview-group { overflow: hidden; background: #fbfcfd; border: 1rpx solid #e2e7ed; border-radius: 22rpx; }
.ship-preview-group .ship-preview-box { border: 0; border-radius: 0; }
.ship-box-expand-body { padding-right: 20rpx; padding-left: 20rpx; }
.ship-submit-notice { padding: 20rpx 24rpx; color: #7b633a; font-size: 20rpx; line-height: 1.55; background: #fff9ed; border: 1rpx solid #f1d8aa; border-radius: 20rpx; }
.ship-bottom { padding-top: 16rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.ship-bottom button { height: 82rpx; line-height: 82rpx; }
.ship-bottom .ship-secondary { width: 160rpx; flex: 0 0 160rpx; }
.ship-bottom .ship-primary { width: auto; min-width: 0; flex: 1 1 auto; }
.ship-photo-progress { position: absolute; right: 0; bottom: 0; left: 0; padding: 9rpx 6rpx; color: #fff; font-size: 20rpx; text-align: center; background: rgba(22,119,255,.82); }
.ship-photo-progress.is-error { background: rgba(196,49,49,.86); }
.ship-photo-progress.is-done { background: rgba(42,132,91,.86); }
.ship-photo-progress.is-pending { background: rgba(83,96,110,.76); }
.ship-upload-error { display: block; padding: 0 28rpx 24rpx; color: #c43131; font-size: 22rpx; }
