<view class="repair-mini-detail"><mini-titlebar title="返修任务详情" showBack="{{true}}" backLeft="{{true}}" bind:back="goBack"/><view wx:if="{{loading}}" class="mini-empty">正在加载返修任务…</view><view wx:elif="{{repair}}" class="repair-mini-content">
  <view class="repair-mini-summary"><view class="repair-mini-heading"><view><text>返修单号</text><b>{{repair.repairNo}}</b></view><text class="mini-status {{repair.status === 'COMPLETED' ? 'mini-status--completed' : ''}}">{{repair.status === 'COMPLETED' ? '已完成' : '未完成'}}</text></view><view class="repair-mini-date"><text>退回日期</text><b>{{repair.returnDate}}</b></view><view class="repair-mini-progress"><view><text>返回进度</text><b>{{repair.returnedQuantity}} / {{repair.warehouseReturnQuantity}}</b><em>{{progress}}%</em></view><view class="repair-mini-track"><view style="width:{{progress}}%"/></view><text>待返回 {{pending}} 件</text></view><view class="repair-mini-stats"><view><text>返修数量</text><b>{{repair.repairedQuantity}}</b></view><view><text>报废数量</text><b>{{repair.scrappedQuantity}}</b></view></view></view>
  <view class="repair-mini-section"><view class="repair-mini-section-head"><b>质检附件</b><text>原始质检文件</text></view><view class="repair-mini-attachment"><view><b>{{repair.originalFilename}}</b><text>Excel 质检附件</text></view><button bindtap="download">查看 / 下载</button></view></view>
  <view class="repair-mini-section"><view class="repair-mini-section-head"><b>待返回产品</b><text>{{repair.lines.length}} 个规格</text></view><view wx:for="{{repair.lines}}" wx:key="inspectionLineId" class="repair-mini-line"><view><b>{{item.productName}}</b><text>{{item.propertiesValue}} · 箱号 {{item.boxNumber}}</text></view><view><text>待返回</text><b>{{item.warehouseReturnQuantity}}</b></view></view></view>
  <view class="repair-mini-section"><view class="repair-mini-section-head"><b>历史发回记录</b><text>0 次</text></view><view class="repair-mini-empty"><b>尚未发回</b><text>S10 开放发回操作后显示</text></view></view>
</view></view>
