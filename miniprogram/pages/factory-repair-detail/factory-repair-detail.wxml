<view class="repair-mini-detail {{repair && repair.status !== 'COMPLETED' ? 'has-preview-action' : ''}}">
  <mini-titlebar title="返修任务详情" showBack="{{true}}" backLeft="{{true}}" bind:back="goBack"/>
  <view wx:if="{{loading}}" class="mini-empty">正在加载返修任务…</view>
  <view wx:elif="{{repair}}" class="repair-mini-content">
    <view class="repair-mini-summary">
      <view class="repair-mini-heading"><view><text>返修单号</text><b>{{repair.repairNo}}</b></view><text class="repair-detail-status {{repair.status === 'COMPLETED' ? 'is-completed' : ''}}">{{repair.status === 'COMPLETED' ? '已完成' : '未完成'}}</text></view>
      <view class="repair-mini-date"><image src="/assets/icons/calendar-blue.svg" mode="aspectFit"/><text>退回日期</text><b>{{returnDateText}}</b></view>
      <view class="repair-mini-progress"><view><text>返回进度</text><b>{{repair.returnedQuantity}} / {{repair.warehouseReturnQuantity}}</b><em>{{progress}}%</em></view><view class="repair-mini-track"><view style="width:{{progress}}%"/></view><text>待返回 <b>{{pending}}</b> 件</text></view>
      <view class="repair-mini-stats"><view><text>返修数量</text><b>{{repair.repairedQuantity}}</b></view><view><text>报废数量</text><b>{{repair.scrappedQuantity}}</b></view></view>
    </view>
    <view class="repair-mini-section"><view class="repair-mini-section-head"><b>质检附件</b><text>原始质检文件</text></view><view class="repair-mini-attachment"><view class="repair-file-icon"><image src="/assets/icons/file-blue.svg" mode="aspectFit"/></view><view><b>{{repair.originalFilename}}</b><text>Excel · {{previewMode ? (repair.repairId === 'preview-repair-1' ? '286 KB' : '314 KB') : '原始文件'}}</text></view><button bindtap="download">查看</button><button bindtap="download">下载</button></view></view>
    <view class="repair-mini-section"><view class="repair-mini-section-head"><b>待返回产品</b><text>{{repair.specs.length}} 个规格</text></view><view class="repair-product-list"><view wx:for="{{productGroups}}" wx:key="productName" class="repair-product-group"><view class="repair-product-summary" data-index="{{index}}" bindtap="toggleProduct"><view><b>{{item.productName}}</b><text>{{item.specCount}} 个规格</text></view><text>待返回 {{item.pendingQuantity}}</text><i class="{{item.expanded ? 'is-open' : ''}}">›</i></view><view wx:if="{{item.expanded}}" class="repair-spec-table"><view class="repair-spec-head"><text>序号</text><text>颜色/规格</text><text>仓库退回</text><text>已返回</text><text>待返回</text></view><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="variantId" class="repair-spec-row"><text>{{index + 1}}</text><b>{{line.propertiesValue}}</b><text>{{line.warehouseReturnQuantity}}</text><text>{{line.returnedQuantity}}</text><b>{{line.pendingQuantity}}</b></view></view></view></view></view>
    <view class="repair-mini-section"><view class="repair-mini-section-head"><b>历史发回记录</b><text>{{returnBatches.length}} 次</text></view><view wx:if="{{!returnBatches.length}}" class="repair-mini-empty"><image class="repair-empty-truck" src="/assets/icons/truck-muted.svg" mode="aspectFit"/><b>尚未发回</b><text>提交返修发回记录后将在这里显示。</text></view><view wx:else class="repair-history-list"><view wx:for="{{returnBatches}}" wx:key="batchId" class="repair-history-batch"><view class="repair-history-summary" data-index="{{index}}" bindtap="toggleBatch"><view><b>{{item.returnDate}}</b><text>{{item.lines.length}} 个规格</text></view><text>发回 {{item.returnedQuantity}}</text><i class="{{item.expanded ? 'is-open' : ''}}">›</i></view><view wx:if="{{item.expanded}}" class="repair-history-table"><view class="repair-history-head"><text>产品名称</text><text>颜色/规格</text><text>返修数量</text><text>报废数量</text><text>本次发回</text></view><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="variantId" class="repair-history-row"><b>{{line.productName}}</b><text>{{line.propertiesValue}}</text><text>{{line.repairedQuantity}}</text><text>{{line.scrappedQuantity}}</text><b>{{line.returnedQuantity}}</b></view></view></view></view></view>
  </view>
  <view wx:if="{{repair && repair.status !== 'COMPLETED'}}" class="repair-preview-action"><button bindtap="openReturn">发回返修品</button></view>
</view>
