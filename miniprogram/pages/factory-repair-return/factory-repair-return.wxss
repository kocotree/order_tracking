.repair-return-page { min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: #f3f5f8; }
.repair-return-content { display: grid; gap: 18rpx; padding: 20rpx 28rpx 28rpx; }
.repair-return-summary,.repair-return-product,.repair-return-totals,.repair-return-preview-totals,.repair-return-preview-list { overflow: hidden; background: #fff; border: 1rpx solid #e2e7ed; border-radius: 30rpx; box-shadow: 0 10rpx 28rpx rgba(34,50,70,.06); }
.repair-return-summary { padding: 22rpx; }
.repair-return-summary-head { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #e2e7ed; }
.repair-return-summary-head text,.repair-return-progress text,.repair-return-pending text,.repair-return-totals text,.repair-return-preview-totals text { color: #000; font-size: 22rpx; }
.repair-return-summary-head b { font-size: 34rpx; }
.repair-return-progress { padding: 16rpx 0; }
.repair-return-progress > view:first-child { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.repair-return-progress b { font-size: 26rpx; text-align: right; }
.repair-return-progress em { color: #000; font-size: 22rpx; font-style: normal; font-weight: 750; }
.repair-return-track { height: 12rpx; overflow: hidden; background: #e6ebf0; border-radius: 99rpx; }
.repair-return-track view { height: 100%; background: #1677ff; border-radius: inherit; }
.repair-return-pending { display: flex; align-items: baseline; padding-top: 16rpx; border-top: 1rpx solid #e2e7ed; }
.repair-return-pending b { margin-left: auto; color: #000; font-size: 46rpx; }
.repair-return-pending small { margin-left: 8rpx; color: #000; font-size: 20rpx; }
.repair-return-hint { padding: 20rpx 24rpx; color: #000; font-size: 22rpx; line-height: 1.55; background: #f2f7ff; border: 1rpx solid #d7e7fb; border-radius: 20rpx; }
.repair-return-product-head,.repair-return-preview-head { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; gap: 24rpx; padding: 18rpx 28rpx; border-bottom: 1rpx solid #e2e7ed; }
.repair-return-product-head > view { display: grid; gap: 6rpx; min-width: 0; }
.repair-return-product-head b,.repair-return-preview-head b { font-size: 28rpx; }
.repair-return-preview-head b { font-weight: 850; }
.repair-return-product-head text,.repair-return-preview-head text { color: #000; font-size: 20rpx; }
.repair-return-product-head strong { color: #000; font-size: 22rpx; white-space: nowrap; }
.repair-return-spec { display: grid; gap: 16rpx; padding: 20rpx; background: #fff; border-top: 1rpx solid #e2e7ed; }
.repair-return-spec:first-of-type { border-top: 0; }
.repair-return-spec.is-selected { background: #f8fbff; }
.repair-return-select { display: flex; align-items: center; gap: 20rpx; }
.repair-return-select checkbox { transform: scale(.88); }
.repair-return-select > view { display: grid; gap: 4rpx; }
.repair-return-select b { font-size: 26rpx; }
.repair-return-select text { color: #000; font-size: 20rpx; }
.repair-return-facts { display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; background: #f8fafc; border: 1rpx solid #e7ebf0; border-radius: 18rpx; }
.repair-return-facts view { display: grid; gap: 6rpx; padding: 16rpx 10rpx; text-align: center; border-left: 1rpx solid #e7ebf0; }
.repair-return-facts view:first-child { border-left: 0; }
.repair-return-facts text { color: #000; font-size: 18rpx; }
.repair-return-facts b { font-size: 26rpx; }
.repair-return-inputs { display: grid; grid-template-columns: repeat(2,1fr); gap: 20rpx; }
.repair-return-inputs label { display: grid; gap: 10rpx; }
.repair-return-inputs label > text { color: #000; font-size: 22rpx; font-weight: 700; }
.repair-return-inputs input { box-sizing: border-box; width: 100%; height: 84rpx; padding: 0 22rpx; background: #fff; border: 1rpx solid #dce2e9; border-radius: 18rpx; font-size: 30rpx; }
.repair-return-inputs input[disabled] { color: #000; background: #f2f4f6; }
.repair-return-totals { display: grid; grid-template-columns: repeat(2,1fr); }
.repair-return-totals > view,.repair-return-preview-totals > view { display: grid; gap: 8rpx; min-height: 132rpx; padding: 24rpx 28rpx; border-left: 1rpx solid #e2e7ed; }
.repair-return-totals > view:first-child,.repair-return-preview-totals > view:first-child { border-left: 0; }
.repair-return-totals b,.repair-return-preview-totals b { font-size: 42rpx; }
.repair-return-total-all { grid-column: 1/-1; display: flex !important; min-height: 108rpx !important; align-items: baseline; border-top: 1rpx solid #e2e7ed; border-left: 0 !important; }
.repair-return-total-all b { margin-left: auto; color: #000; }
.repair-return-primary { box-sizing: border-box; width: 100% !important; min-width: 0; max-width: none; height: 94rpx; justify-self: stretch; margin: 0; padding: 0; color: #000; font-size: 28rpx; font-weight: 750; line-height: 94rpx; background: #4778f6; border-radius: 22rpx; }
.repair-return-preview-totals { display: grid; grid-template-columns: repeat(3,1fr); }
.repair-return-preview-totals > view { min-height: 150rpx; padding: 26rpx 22rpx; text-align: center; }
.repair-return-preview-totals > view:last-child b { color: #000; }
.repair-return-preview-line { display: grid; grid-template-columns: 48rpx minmax(0,1fr); gap: 16rpx; padding: 24rpx; border-top: 1rpx solid #e2e7ed; }
.repair-return-index { display: grid; width: 46rpx; height: 46rpx; place-items: center; color: #000; font-size: 20rpx; font-weight: 750; background: #eaf3ff; border-radius: 14rpx; }
.repair-return-preview-line > view:nth-child(2) { display: grid; gap: 6rpx; min-width: 0; }
.repair-return-preview-line > view:nth-child(2) b { overflow: hidden; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.repair-return-preview-line > view:nth-child(2) text { color: #000; font-size: 20rpx; }
.repair-return-preview-values { grid-column: 2; display: grid; grid-template-columns: repeat(3,1fr); margin-top: 14rpx; overflow: hidden; background: #f8fafc; border: 1rpx solid #e7ebf0; border-radius: 18rpx; }
.repair-return-preview-values view { display: grid; gap: 6rpx; padding: 14rpx 10rpx; text-align: center; border-left: 1rpx solid #e7ebf0; }
.repair-return-preview-values view:first-child { border-left: 0; }
.repair-return-preview-values text { color: #000; font-size: 18rpx; }
.repair-return-preview-values b { font-size: 26rpx; }
.repair-return-actions { display: grid; width: 100%; grid-template-columns: 200rpx minmax(0,1fr); gap: 18rpx; }
.repair-return-actions button { box-sizing: border-box; width: 100% !important; min-width: 0; max-width: none; height: 94rpx; justify-self: stretch; margin: 0; padding: 0; color: #000; font-size: 28rpx; font-weight: 750; line-height: 94rpx; background: #fff; border: 1rpx solid #d8dfe7; border-radius: 22rpx; }
.repair-return-actions button.is-primary { color: #000; background: #4778f6; border-color: #4778f6; }

/* Issue #43: the confirmed monochrome, bold form includes preview and controls. */
.repair-return-page view,
.repair-return-page text,
.repair-return-page b,
.repair-return-page strong,
.repair-return-page small,
.repair-return-page em,
.repair-return-page button,
.repair-return-page input { color: #000; font-weight: 700; }
.repair-return-summary-head text,
.repair-return-progress text,
.repair-return-pending text { font-size: 28rpx; }
.repair-return-facts text { font-size: 26rpx; }
.repair-return-product-head > view { flex: 1; }
.repair-return-product-head { gap: 14rpx; }
.repair-return-chevron { flex: 0 0 24rpx; font-size: 34rpx !important; text-align: center; transform: rotate(0); }
.repair-return-chevron.is-expanded { transform: rotate(90deg); }
.repair-return-spec.is-collapsed { display: none; }

/* Follow-up confirmation: match shipment steps and retain explicit color exceptions. */
.repair-return-page .ship-step text { color: #8c96a3; }
.repair-return-page .ship-step.is-active text { color: #1677ff; }
.repair-return-page .ship-step.is-active text:first-child { color: #fff; }
.repair-return-page .repair-return-product-head strong { color: #1677ff; }
.repair-return-page .repair-return-primary,
.repair-return-page .repair-return-actions button.is-primary { color: #fff; }
