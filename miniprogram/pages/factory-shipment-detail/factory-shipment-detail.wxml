<view class="ship-detail-page {{shipment && shipment.status === 'SHIPPED' ? 'has-withdraw-bar' : ''}}">
  <mini-titlebar title="发货单详情" showBack="{{true}}" backLeft="{{true}}" bind:back="goBack"/>
  <view wx:if="{{loading}}" class="mini-empty">正在加载发货单…</view>
  <view wx:elif="{{shipment}}" class="ship-detail-content">
    <view class="ship-detail-hero">
      <view class="ship-detail-title"><text>{{shipment.shipmentNo}}</text><text wx:if="{{shipment.status === 'VOID_PENDING'}}" class="withdraw-status">撤回处理中</text><text wx:elif="{{shipment.status === 'VOIDED'}}" class="withdraw-status is-voided">已作废</text></view>
      <view class="ship-detail-meta"><view><text>发货日期</text><b>{{shipment.businessDate}}</b></view><view><text>发货数量</text><b>{{shipment.totalQuantity}}</b></view><view><text>总箱数</text><b>{{shipment.totalBoxes}}</b></view></view>
    </view>
    <view class="ship-card"><view class="ship-card-head"><text>发货明细</text><text>{{shipment.lines.length}} 个规格</text></view><view wx:for="{{lineGroups}}" wx:key="orderNo" class="ship-detail-group"><view role="button" class="ship-detail-summary" data-order-no="{{item.orderNo}}" bindtap="toggleLineGroup"><view><text>{{item.orderNo}}</text><text>{{item.items.length}} 个产品规格</text></view><b>合计 {{item.total}}</b><text class="detail-chevron {{item.expanded ? 'is-open' : ''}}">›</text></view><view wx:if="{{item.expanded}}" class="mini-expand-table"><view class="mini-expand-table-head"><text>序号</text><text>产品名称</text><text>颜色/规格</text><text>数量</text></view><view wx:for="{{item.items}}" wx:key="assignmentId" class="mini-expand-table-row"><text>{{index + 1}}</text><text>{{item.productName}}</text><text>{{item.propertiesValue}}</text><b>{{item.quantity}}</b></view></view></view></view>
    <view class="ship-card"><view class="ship-card-head"><text>装箱明细</text><text>共 {{shipment.totalBoxes}} 箱</text></view><view wx:for="{{boxGroups}}" wx:key="boxNo" class="ship-detail-group"><view role="button" class="ship-detail-summary" data-box-no="{{item.boxNo}}" bindtap="toggleBoxGroup"><view><text>箱号 {{item.boxNo}}</text><text>{{item.items.length}} 个产品规格</text></view><b>合计 {{item.total}}</b><text class="detail-chevron {{item.expanded ? 'is-open' : ''}}">›</text></view><view wx:if="{{item.expanded}}" class="mini-expand-table"><view class="mini-expand-table-head"><text>序号</text><text>产品名称</text><text>颜色/规格</text><text>数量</text></view><view wx:for="{{item.items}}" wx:key="assignmentId" class="mini-expand-table-row"><text>{{index + 1}}</text><text>{{item.productName}}　{{item.orderNo}}</text><text>{{item.propertiesValue}}</text><b>{{item.quantity}}</b></view></view></view></view>
    <view class="ship-card"><view class="ship-card-head"><text>发货凭证</text><text>0 张</text></view><view class="ship-empty">工厂未上传发货凭证</view></view>
    <view class="ship-card"><view class="ship-card-head"><text>工厂备注</text></view><view class="ship-note">{{shipment.note || '—'}}</view></view>
    <view class="ship-card"><view class="ship-card-head"><text>操作记录</text></view><view wx:if="{{shipment.voidRequest}}" class="shipment-operation is-withdraw"><i></i><view><b>提交撤回发货</b><text>{{shipment.voidRequest.reason}}</text><text wx:if="{{shipment.voidRequest.status === 'REJECTED'}}">审核结果：已拒绝　{{shipment.voidRequest.reviewComment}}</text><text wx:elif="{{shipment.voidRequest.status === 'APPROVED'}}">审核结果：已通过</text><text wx:else>等待管理员审核</text></view></view><view class="shipment-operation"><i></i><view><b>提交发货单</b><text>{{submittedAtText}}</text></view></view></view>
  </view>

  <view wx:if="{{shipment && shipment.status === 'SHIPPED'}}" class="shipment-withdraw-bar"><button bindtap="openWithdraw">撤回发货</button></view>
  <view wx:if="{{withdrawStep}}" class="shipment-withdraw-layer" bindtap="closeWithdraw"><view class="shipment-withdraw-sheet" catchtap="stopPropagation"><view class="sheet-handle"></view><view class="withdraw-sheet-head"><view><text>发货单 {{shipment.shipmentNo}}</text><b>{{withdrawStep === 'confirm' ? '确认撤回发货' : '撤回发货'}}</b></view><button bindtap="closeWithdraw">×</button></view>
    <view wx:if="{{withdrawStep === 'form'}}" class="withdraw-form"><view class="withdraw-summary"><view><text>发货日期</text><b>{{shipment.businessDate}}</b></view><view><text>发货数量</text><b>{{shipment.totalQuantity}}</b></view></view><view class="withdraw-reason-field"><text>撤回原因</text><textarea value="{{withdrawReason}}" maxlength="500" placeholder="请填写撤回原因" bindinput="updateWithdrawReason"></textarea><text>{{withdrawReason.length}}/500</text></view><text class="withdraw-error">{{withdrawError}}</text></view>
    <view wx:else class="withdraw-confirm"><text>提交后将进入管理员审核，审核通过前不会扣减订单已发数量。</text><view><text>发货日期</text><b>{{shipment.businessDate}}</b></view><view><text>发货数量</text><b>{{shipment.totalQuantity}}</b></view><view><text>撤回原因</text><b>{{withdrawReason}}</b></view><text class="withdraw-error">{{withdrawError}}</text></view>
    <view class="withdraw-actions"><button bindtap="closeWithdraw">取消</button><button wx:if="{{withdrawStep === 'confirm'}}" class="is-danger" disabled="{{submitting}}" bindtap="confirmWithdraw">{{submitting ? '提交中…' : '确认提交'}}</button><button wx:else class="is-danger" bindtap="nextWithdraw">提交撤回</button></view>
  </view></view>
</view>
