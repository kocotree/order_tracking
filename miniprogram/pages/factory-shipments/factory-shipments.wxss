.ship-record-page { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }
.ship-record-actions { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 18rpx; padding: 20rpx 28rpx 28rpx; background: #fff; }
.ship-record-search { display: flex; min-width: 0; height: 88rpx; align-items: center; gap: 16rpx; padding: 0 24rpx; background: #f7f9fb; border: 1rpx solid #dce2e9; border-radius: 24rpx; }
.ship-record-search image { width: 36rpx; height: 36rpx; flex: 0 0 36rpx; }
.ship-record-search input { min-width: 0; flex: 1; font-size: 27rpx; }
.ship-record-filter { position: relative; display: flex; width: 152rpx; height: 88rpx; padding: 0 20rpx; align-items: center; justify-content: center; gap: 10rpx; color: #1677ff; font-size: 27rpx; font-weight: 750; line-height: 88rpx; background: #fff; border: 1rpx solid #cfe0f8; border-radius: 24rpx; }
.ship-record-filter b { position: absolute; top: -10rpx; right: -8rpx; display: grid; width: 38rpx; height: 38rpx; place-items: center; color: #fff; font-size: 19rpx; background: #e85b5d; border: 4rpx solid #fff; border-radius: 50%; }
.filter-icon { width: 36rpx; height: 36rpx; flex: 0 0 36rpx; }
.ship-record-content { display: block; padding: 24rpx 28rpx 40rpx; }
.ship-record-count { display: block; padding: 0 8rpx 18rpx; color: #6f7a87; font-size: 23rpx; }
.ship-record-card { display: block; box-sizing: border-box; width: calc(100vw - 56rpx); max-width: none; margin: 0 0 24rpx; overflow: hidden; color: #1c2430; text-align: left; background: #fff; border: 1rpx solid #e2e7ed; border-radius: 32rpx; box-shadow: 0 10rpx 28rpx rgba(34,50,70,.06); }
.ship-record-title { display: flex; min-height: 100rpx; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx 32rpx; }
.ship-record-title text:first-child { min-width: 0; overflow: hidden; font-size: 30rpx; font-weight: 800; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.ship-record-title text:last-child { color: #7b8694; font-size: 38rpx; }
.ship-record-date { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; padding: 0 32rpx; border-top: 1rpx solid #e3e7ec; border-bottom: 1rpx solid #e3e7ec; }
.ship-record-date-label { display: flex; align-items: center; gap: 12rpx; color: #6f7a87; font-size: 25rpx; font-weight: 700; }
.ship-record-date-label image { width: 34rpx; height: 34rpx; flex: 0 0 34rpx; }
.ship-record-date b { color: #1c2430; font-size: 26rpx; font-weight: 700; }
.ship-record-stats { display: grid; grid-template-columns: repeat(2,1fr); margin: 0; padding: 26rpx 32rpx; background: #fff; border-radius: 0; }
.ship-record-stats view { display: grid; justify-items: start; gap: 8rpx; padding-left: 26rpx; border-left: 1rpx solid #e1e5ea; border-right: 0; }
.ship-record-stats view:first-child { padding-left: 0; border-left: 0; }
.ship-record-stats text { color: #788493; font-size: 20rpx; }
.ship-record-stats b { font-size: 32rpx; font-weight: 800; }
.ship-record-number { display: flex; min-height: 76rpx; align-items: center; justify-content: flex-start; gap: 14rpx; margin: 0; padding: 0 32rpx; color: #7a8592; font-size: 21rpx; background: #fbfcfd; border-top: 1rpx solid #e6e9ed; }
.ship-record-number b { font-size: 23rpx; letter-spacing: .02em; }
.ship-clear-filter { margin-top: 18rpx; padding: 0 28rpx; height: 64rpx; color: #1677ff; font-size: 23rpx; line-height: 64rpx; background: #eaf3ff; border-radius: 16rpx; }
.record-sheet-layer { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(16,24,36,.42); }
.record-filter-sheet { position: relative; width: 100%; padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 34rpx 34rpx 0 0; }
.record-sheet-handle { width: 84rpx; height: 8rpx; margin: 0 auto 24rpx; background: #d8dde4; border-radius: 6rpx; }
.record-sheet-header { display: flex; min-height: 64rpx; align-items: center; }
.record-sheet-header b { font-size: 36rpx; }
.record-sheet-header button { position: absolute; top: 24rpx; right: 28rpx; width: 64rpx; height: 64rpx; color: #53606e; font-size: 40rpx; line-height: 64rpx; background: #f2f4f7; border-radius: 50%; }
.record-filter-body { padding: 38rpx 0; }
.record-filter-body > text { display: block; margin-bottom: 14rpx; color: #53606e; font-size: 24rpx; font-weight: 700; }
.record-date-range { display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 14rpx; }
.record-date-range picker view { height: 76rpx; padding: 0 18rpx; color: #566271; font-size: 24rpx; line-height: 76rpx; background: #f8fafc; border: 1rpx solid #dce2e9; border-radius: 16rpx; }
.record-date-range > text { color: #7a8491; font-size: 23rpx; }
.record-filter-actions { display: grid; grid-template-columns: 1fr 2fr; gap: 16rpx; }
.record-filter-reset,.record-filter-apply { height: 82rpx; font-size: 27rpx; font-weight: 750; line-height: 82rpx; background: #f2f4f7; border-radius: 18rpx; }
.record-filter-apply { color: #fff; background: #1677ff; }
