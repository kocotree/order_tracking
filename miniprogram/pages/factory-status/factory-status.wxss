.factory-status-page { min-height: 100vh; padding: 72rpx 28rpx 56rpx; background: #f4f5f7; }
.state-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 30rpx 34rpx; background: #fff; border: 1rpx solid #e5e8ed; border-radius: 18rpx; box-shadow: 0 12rpx 34rpx rgba(43,56,75,.06); }
.state-mark { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; color: #a76c07; font-size: 42rpx; font-weight: 750; background: #fff6df; border-radius: 50%; }
.status-rejected .state-mark { color: #d84f51; background: #fff0f0; }
.status-disabled .state-mark { color: #687283; background: #eef1f4; }
.state-kicker { margin-top: 26rpx; color: #087fd1; font-size: 23rpx; font-weight: 700; }
.state-title { margin-top: 12rpx; color: #20242b; font-size: 40rpx; font-weight: 750; }
.state-description { margin-top: 14rpx; color: #687283; font-size: 25rpx; line-height: 1.7; text-align: center; }
.application-facts { width: 100%; margin-top: 30rpx; overflow: hidden; border: 1rpx solid #e5e8ed; border-radius: 12rpx; }
.application-facts view { display: grid; grid-template-columns: 190rpx 1fr; min-height: 78rpx; border-bottom: 1rpx solid #e5e8ed; }
.application-facts view:last-child { border-bottom: 0; }
.application-facts text { padding: 20rpx; color: #20242b; font-size: 24rpx; }
.application-facts text:first-child { color: #687283; background: #f7f8fa; }
.application-facts .reject-row text:last-child { color: #d84f51; }
.disabled-factory { display: flex; width: 100%; justify-content: space-between; padding: 24rpx; margin-top: 30rpx; color: #687283; font-size: 26rpx; background: #f7f8fa; border-radius: 12rpx; }
.disabled-factory text:last-child { color: #20242b; font-weight: 700; }
.primary-action { height: 88rpx; margin-top: 30rpx; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 88rpx; background: #0d8fe9; border-radius: 14rpx; }
.logout-action { margin-top: 12rpx; color: #687283; font-size: 26rpx; background: transparent; }
.logout-action::after { border: 0; }
