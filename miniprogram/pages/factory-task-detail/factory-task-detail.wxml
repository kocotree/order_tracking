<view class="order-mini-page"><mini-titlebar title="任务详情" showBack="{{true}}" bind:back="goBack" /><view wx:if="{{loading}}" class="mini-empty">正在加载任务…</view><view wx:elif="{{error}}" class="mini-empty mini-error">{{error}}</view><view wx:elif="{{order}}" class="mini-detail-content"><view class="mini-detail-hero"><view class="mini-card-head"><text>{{order.orderNo}}</text><text class="mini-status mini-status--{{statusTone}}">{{order.displayStatus}}</text></view><text class="mini-product-summary">{{productSummary}}</text><view class="mini-card-meta"><text>合同出货 {{order.contractShipDate}}</text></view></view><view class="mini-quantity-grid mini-detail-quantity"><view><text>{{totalText}}</text><text>下单数量</text></view><view><text>{{shippedText}}</text><text>已发数量</text></view><view><text>{{pendingText}}</text><text>未发数量</text></view></view><view class="mini-section"><view class="mini-section-title">本厂产品规格</view><view wx:for="{{order.lines}}" wx:key="orderLineId" class="mini-line-row"><view><text>{{item.productName}}</text><text>{{item.propertiesValue}}</text></view><view><text>下单 {{item.orderQuantity}}</text><text>已发 {{item.shippedQuantity}}</text><text>未发 {{item.pendingQuantity}}</text></view></view></view><view class="mini-section"><view class="mini-section-title">发货进度</view><view class="mini-progress mini-detail-progress"><view><view style="width: {{order.progressPercent}}%" /></view><text>{{order.progressPercent}}%</text></view></view></view></view>
