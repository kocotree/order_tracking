<view class="order-mini-page factory-detail-page">
  <mini-titlebar title="任务详情" showBack="{{true}}" backLeft="{{true}}" bind:back="goBack" />

  <view wx:if="{{loading}}" class="mini-empty">正在加载任务…</view>
  <view wx:elif="{{error}}" class="mini-empty mini-error">{{error}}</view>
  <view wx:elif="{{order}}" class="factory-detail-content">
    <view class="factory-summary-card">
      <view class="factory-summary-head">
        <view class="factory-summary-copy">
          <text class="factory-order-number">{{order.orderNo}}</text>
          <text class="factory-product-summary">{{productSummary}}</text>
        </view>
        <text class="mini-status mini-status--{{statusTone}}">{{order.displayStatus}}</text>
      </view>

      <view class="factory-due-row {{statusTone === 'overdue' ? 'is-overdue' : ''}}">
        <view class="factory-calendar-icon" />
        <text>合同出货时间</text>
        <text class="factory-due-value">{{contractShipDateText}}</text>
      </view>

      <view class="factory-progress-row">
        <text class="factory-progress-label">发货进度</text>
        <view class="factory-progress-track"><view class="factory-progress-fill" style="width: {{order.progressPercent}}%" /></view>
        <text class="factory-progress-percent">{{order.progressPercent}}%</text>
      </view>

      <view class="factory-quantity-grid">
        <view><text>下单</text><text>{{totalText}}</text></view>
        <view><text>已发</text><text>{{shippedText}}</text></view>
        <view><text>未发</text><text class="{{order.pendingQuantity > 0 ? 'is-pending' : ''}}">{{pendingText}}</text></view>
      </view>
    </view>

    <view class="factory-product-card">
      <view class="factory-product-card-head"><text>产品明细</text><text>{{order.lines.length}} 条</text></view>
      <view class="factory-product-table">
        <view class="factory-product-table-head">
          <text>序号</text><text>产品名称</text><text>颜色/规格</text><text>下单</text><text>已发</text><text>未发</text>
        </view>
        <view wx:for="{{order.lines}}" wx:key="orderLineId" class="factory-product-row">
          <text class="factory-product-index">{{item.index}}</text>
          <text class="factory-product-name">{{item.productName}}</text>
          <text class="factory-product-spec">{{item.propertiesValue}}</text>
          <text class="factory-product-number">{{item.orderText}}</text>
          <text class="factory-product-number">{{item.shippedText}}</text>
          <text class="factory-product-number {{item.pendingQuantity > 0 ? 'is-pending' : ''}}">{{item.pendingText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
