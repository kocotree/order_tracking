<view class="order-mini-page factory-task-page {{activeTab === 'orders' ? 'has-create-shipment' : ''}}">
  <mini-titlebar title="任务" />

  <view class="factory-task-tabs" role="tablist">
    <button class="factory-task-tab {{activeTab === 'orders' ? 'is-active' : ''}}" data-tab="orders" bindtap="selectTab">订单</button>
    <button class="factory-task-tab {{activeTab === 'repairs' ? 'is-active' : ''}}" data-tab="repairs" bindtap="selectTab">返修</button>
  </view>

  <block wx:if="{{activeTab === 'orders'}}">
    <view class="mini-search-bar factory-search-bar">
      <view class="mini-search-field"><image class="mini-search-icon" src="/assets/icons/search-gray.svg" mode="aspectFit" /><input value="{{keyword}}" placeholder="搜索订单编号或产品名称" bindinput="keywordChanged" confirm-type="search" bindconfirm="search" /></view>
      <button class="factory-filter-button" bindtap="toggleFilter"><view class="mini-filter-icon" /><text>筛选</text><text wx:if="{{activeFilterCount}}" class="mini-filter-count">{{activeFilterCount}}</text></button>
    </view>

    <view class="mini-order-content factory-order-content">
      <view wx:if="{{loading}}" class="mini-empty">正在加载任务…</view>
      <view wx:elif="{{error}}" class="mini-empty mini-error">{{error}}</view>
      <view wx:elif="{{!items.length}}" class="mini-empty"><text>暂无订单任务</text><text>{{previewMode ? '没有符合条件的预览任务' : '发布并派工后会显示在这里'}}</text></view>
      <view wx:else class="mini-order-list">
        <text class="factory-result-summary">共 {{items.length}} 个订单任务</text>
        <view wx:for="{{items}}" wx:key="orderId" class="mini-order-card factory-order-card" data-id="{{item.orderId}}" bindtap="openDetail">
          <view class="mini-card-head">
            <view class="mini-card-heading-copy"><text class="mini-card-number">{{item.orderNo}}</text><text class="mini-product-summary">{{item.productSummary}}</text></view>
            <text class="mini-status mini-status--{{item.statusTone}}">{{item.displayStatus}}</text>
          </view>
          <view class="mini-card-due {{item.statusTone === 'overdue' ? 'is-overdue' : ''}}">
            <view class="mini-fact-icon mini-fact-icon--calendar" /><text>合同出货时间</text><text class="mini-due-value">{{item.contractShipDateText}}</text>
          </view>
          <view class="mini-card-quantities">
            <view class="mini-quantity-item is-first"><text class="mini-quantity-label">下单</text><text class="mini-quantity-value">{{item.totalText}}</text></view>
            <view class="mini-quantity-item"><text class="mini-quantity-label">已发</text><text class="mini-quantity-value">{{item.shippedText}}</text></view>
            <view class="mini-quantity-item"><text class="mini-quantity-label">未发</text><text class="mini-quantity-value {{item.pendingQuantity > 0 ? 'is-pending' : ''}}">{{item.pendingText}}</text></view>
          </view>
          <view class="mini-card-progress"><view class="mini-progress-track"><view class="mini-progress-fill" style="width: {{item.progressPercent}}%" /></view><text class="mini-progress-percent">{{item.progressPercent}}%</text></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="mini-search-bar factory-search-bar repair-search-bar">
      <view class="mini-search-field repair-search-field"><image class="mini-search-icon" src="/assets/icons/search-gray.svg" mode="aspectFit"/><input value="{{keyword}}" placeholder="返修单号或产品名称" bindinput="keywordChanged" confirm-type="search" bindconfirm="search"/></view>
      <button class="factory-filter-button repair-filter-button" bindtap="toggleFilter"><image src="/assets/icons/filter-blue.svg" mode="aspectFit"/><text>筛选</text><text wx:if="{{repairActiveFilterCount}}" class="mini-filter-count">{{repairActiveFilterCount}}</text></button>
    </view>
    <view class="repair-task-content">
      <view wx:if="{{loading}}" class="mini-empty">正在加载返修任务…</view>
      <view wx:elif="{{error}}" class="mini-empty mini-error">{{error}}</view>
      <view wx:elif="{{!repairItems.length}}" class="mini-empty"><text>暂无返修任务</text><text>管理员创建返修单后会显示在这里</text></view>
      <block wx:else>
        <text class="repair-result-summary">共 {{repairItems.length}} 个返修任务</text>
        <view wx:for="{{repairItems}}" wx:key="repairId" class="repair-task-card" data-id="{{item.repairId}}" bindtap="openRepair">
          <view class="repair-task-card-head"><view><b>{{item.repairNo}}</b><text>{{item.productSummary}}</text></view><text class="repair-task-status {{item.status === 'COMPLETED' ? 'is-completed' : ''}}">{{item.status === 'COMPLETED' ? '已完成' : '未完成'}}</text></view>
          <view class="repair-task-date"><image src="/assets/icons/calendar-blue.svg" mode="aspectFit"/><text>退回日期</text><b>{{item.returnDateText}}</b></view>
          <view class="repair-task-stats"><view><text>仓库退回</text><b>{{item.warehouseReturnQuantity}}</b></view><view><text>已返回</text><b>{{item.returnedQuantity}}</b></view><view><text>待返回</text><b class="{{item.pending > 0 ? 'is-pending' : ''}}">{{item.pending}}</b></view></view>
          <view class="repair-task-progress"><text>返回进度</text><view><view style="width:{{item.progress}}%"/></view><b>{{item.progress}}%</b></view>
        </view>
      </block>
    </view>
  </block>

  <view wx:if="{{activeTab === 'orders'}}" class="factory-create-shipment-bar">
    <button class="factory-create-shipment-button" bindtap="createShipment">创建发货单</button>
  </view>

  <view wx:if="{{filterOpen}}" class="mini-sheet-layer" bindtap="closeFilter">
    <view class="mini-filter-sheet" catchtap="stopPropagation">
      <view class="mini-sheet-handle" />
      <view class="mini-sheet-header"><text class="mini-sheet-heading">筛选{{activeTab === 'repairs' ? '返修' : '订单'}}任务</text><view role="button" aria-label="关闭筛选" class="mini-sheet-close" bindtap="closeFilter"><view class="mini-sheet-close-line" /><view class="mini-sheet-close-line is-reversed" /></view></view>
      <view class="mini-filter-body">
        <block wx:if="{{activeTab === 'repairs'}}"><view class="mini-filter-field"><text class="mini-filter-label">返修状态</text><picker range="{{repairStatusOptions}}" range-key="label" value="{{draftRepairStatusIndex}}" bindchange="repairStatusChanged"><view class="mini-picker-value"><text>{{repairStatusOptions[draftRepairStatusIndex].label}}</text><view class="mini-picker-arrow" /></view></picker></view></block>
        <block wx:else><view class="mini-filter-field"><text class="mini-filter-label">订单状态</text><picker range="{{statusOptions}}" range-key="label" value="{{draftStatusIndex}}" bindchange="statusChanged"><view class="mini-picker-value"><text>{{statusOptions[draftStatusIndex].label}}</text><view class="mini-picker-arrow" /></view></picker></view><view class="mini-filter-field"><text class="mini-filter-label">合同出货时间范围</text><view class="mini-date-range"><picker mode="date" value="{{draftShipDateFrom}}" bindchange="shipDateFromChanged"><view class="mini-date-value"><text class="mini-date-copy {{draftShipDateFrom ? '' : 'is-placeholder'}}">{{draftShipDateFrom || 'yyyy/mm/日'}}</text><view class="mini-date-icon" /></view></picker><text class="mini-date-separator">至</text><picker mode="date" value="{{draftShipDateTo}}" bindchange="shipDateToChanged"><view class="mini-date-value"><text class="mini-date-copy {{draftShipDateTo ? '' : 'is-placeholder'}}">{{draftShipDateTo || 'yyyy/mm/日'}}</text><view class="mini-date-icon" /></view></picker></view></view></block>
      </view>
      <view class="mini-filter-actions"><button class="mini-filter-reset" bindtap="resetFilter">重置</button><button class="mini-filter-apply" bindtap="applyFilter">查看结果</button></view>
    </view>
  </view>

  <mini-tabbar items="{{navigationItems}}" active-key="primary" />
</view>
