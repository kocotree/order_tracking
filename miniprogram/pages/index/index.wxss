.baseline-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.baseline-card {
  display: flex;
  width: 100%;
  flex-direction: column;
  padding: 48rpx;
  border: 1rpx solid #e0e5ee;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 56rpx rgba(23, 32, 51, 0.08);
}

.baseline-kicker {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.baseline-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.baseline-description {
  margin-top: 20rpx;
  color: #5d6678;
  font-size: 28rpx;
  line-height: 1.7;
}
