.notifications-page{min-height:100vh;background:#f3f5f8}.notification-tabs{display:flex;height:88rpx;padding:0 28rpx;background:#fff;border-bottom:1rpx solid #e2e7ed}.notification-tabs button{position:relative;display:flex;flex:1;box-sizing:border-box;align-items:center;justify-content:center;color:#6a7583;font-size:28rpx;background:transparent;border:0}.notification-tabs button.is-active{color:#1267c9;font-weight:750}.notification-tabs button.is-active::after{position:absolute;right:32%;bottom:0;left:32%;height:4rpx;content:"";background:#1677ff;border-radius:2rpx}.notification-list{display:grid;gap:18rpx;padding:24rpx 28rpx}.notification-item{display:grid;gap:13rpx;width:100%;padding:28rpx 30rpx;margin:0;color:#1c2430;text-align:left;background:#fff;border:1rpx solid #e2e7ed;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(32,48,68,.05)}.notification-head{display:flex;min-width:0;gap:18rpx;align-items:center;justify-content:space-between}.notification-meta{display:flex;min-width:0;gap:12rpx;align-items:center}.notification-dot{flex:0 0 auto;width:14rpx;height:14rpx;background:#1677ff;border-radius:50%}.notification-category{flex:0 0 auto;color:#1267c9;font-size:23rpx;font-weight:750;white-space:nowrap}.notification-time{flex:0 0 auto;color:#9099a5;font-size:21rpx;white-space:nowrap}.notification-title-row{display:flex;min-width:0;gap:18rpx;align-items:center;justify-content:space-between}.notification-title{min-width:0;overflow:hidden;font-size:29rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.notification-arrow{flex:0 0 auto;color:#8a94a1;font-size:36rpx}.notification-summary{display:-webkit-box;overflow:hidden;color:#5f6b79;font-size:25rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.notification-empty,.notification-loading{display:grid;min-height:420rpx;color:#8a94a1;font-size:26rpx;place-items:center}.notification-more{width:220rpx;height:72rpx;margin:0 auto 40rpx;color:#1267c9;font-size:25rpx;background:#fff;border:1rpx solid #cfd7e1;border-radius:36rpx}
