<view class="profile-page" wx:if="{{user}}">
  <mini-titlebar title="我的" />
  <view class="profile-content">
    <view class="profile-hero">
      <button wx:if="{{user.role === 'admin'}}" class="profile-avatar" loading="{{uploading}}" bindtap="openAvatarActions">
        <image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" />
        <text wx:else>{{avatarFallback}}</text>
      </button>
      <view wx:else class="profile-avatar profile-avatar--static"><text>{{avatarFallback}}</text></view>
      <view class="profile-identity">
        <text>{{user.displayName}}</text>
        <text>{{user.role === 'admin' ? (user.isSuperAdmin ? '最高管理员' : '普通管理员') : (user.factoryPosition === 'owner' ? '老板' : '工厂员工')}}</text>
      </view>
    </view>

    <view wx:if="{{user.role === 'admin'}}" class="profile-card">
      <view class="profile-account-row"><text>姓名</text><text>{{user.displayName}}</text></view>
      <view class="profile-account-row"><text>管理员类型</text><text>{{user.isSuperAdmin ? '最高管理员' : '普通管理员'}}</text></view>
      <view class="profile-account-row"><text>联系电话</text><text>{{user.phoneMasked}}</text></view>
      <button class="profile-action-row" loading="{{subscriptionBusy}}" bindtap="requestSubscriptions"><text class="profile-action-label">微信提醒授权</text><text class="profile-authorization-state">{{subscriptionStatus}}</text><text class="profile-action-chevron">›</text></button>
      <button class="profile-action-row" bindtap="openNotifications"><text class="profile-action-label">通知中心</text><text wx:if="{{unreadCount}}" class="profile-notification-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text><text class="profile-action-chevron">›</text></button>
    </view>

    <view wx:else class="profile-card factory-profile-card">
      <view class="profile-account-row"><text>姓名</text><text>{{user.displayName}}</text></view>
      <view class="profile-account-row"><text>联系电话</text><text>{{user.phoneMasked}}</text></view>
      <view class="profile-account-row"><text>职位</text><text>{{user.factoryPosition === 'owner' ? '老板' : '工厂员工'}}</text></view>
      <view class="profile-account-row"><text>所属工厂</text><text>{{user.factoryName}}</text></view>
      <button class="profile-action-row" loading="{{subscriptionBusy}}" bindtap="requestSubscriptions"><text class="profile-action-label">微信提醒授权</text><text class="profile-authorization-state">{{subscriptionStatus}}</text><text class="profile-action-chevron">›</text></button>
      <button class="profile-action-row" bindtap="openNotifications"><text class="profile-action-label">通知中心</text><text wx:if="{{unreadCount}}" class="profile-notification-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text><text class="profile-action-chevron">›</text></button>
    </view>

    <button class="profile-logout-button" bindtap="logout">退出登录</button>
  </view>

  <mini-tabbar items="{{navigationItems}}" active-key="profile" />

  <view wx:if="{{user.role === 'admin' && avatarSheetOpen}}" class="action-layer" bindtap="closeAvatarActions">
    <view class="action-sheet" catchtap="noop">
      <button bindtap="viewAvatar">查看头像</button>
      <button open-type="chooseAvatar" bindchooseavatar="chooseAvatar">更换头像</button>
      <button class="action-cancel" bindtap="closeAvatarActions">取消</button>
    </view>
  </view>
</view>
