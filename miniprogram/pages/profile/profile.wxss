.profile-page { min-height: 100vh; background: #f4f5f7; }
.profile-content { padding: 28rpx 28rpx 56rpx; }
.profile-hero, .profile-card { background: #fff; border: 1rpx solid #e5e8ed; border-radius: 18rpx; box-shadow: 0 12rpx 34rpx rgba(43,56,75,.06); }
.profile-hero { display: flex; gap: 28rpx; align-items: center; padding: 36rpx 32rpx; background: linear-gradient(135deg,#fff,#eef8ff); }
.profile-avatar { display: flex; width: 128rpx !important; height: 128rpx; flex: 0 0 128rpx; align-items: center; justify-content: center; padding: 0; overflow: hidden; color: #fff; font-size: 42rpx; font-weight: 750; line-height: 128rpx; background: #0d8fe9; border: 6rpx solid #fff; border-radius: 50%; box-shadow: 0 12rpx 30rpx rgba(13,143,233,.2); }
.profile-avatar::after { border: 0; }
.profile-avatar image { width: 100%; height: 100%; }
.profile-identity { display: flex; flex-direction: column; gap: 12rpx; }
.profile-identity text:first-child { color: #20242b; font-size: 38rpx; font-weight: 750; }
.profile-identity text:last-child { color: #087fd1; font-size: 25rpx; font-weight: 700; }
.factory-profile-heading { display: flex; flex-direction: column; gap: 12rpx; padding: 42rpx 32rpx; background: linear-gradient(135deg,#fff,#eef8ff); border: 1rpx solid #e5e8ed; border-radius: 18rpx; box-shadow: 0 12rpx 34rpx rgba(43,56,75,.06); }
.factory-profile-heading text:first-child { color: #20242b; font-size: 40rpx; font-weight: 750; }
.factory-profile-heading text:last-child { color: #087fd1; font-size: 25rpx; font-weight: 700; }
.factory-profile-card { margin-top: 28rpx; }
.profile-card { margin-top: 28rpx; overflow: hidden; }
.profile-card__header { padding: 25rpx 28rpx; color: #20242b; font-size: 28rpx; font-weight: 750; border-bottom: 1rpx solid #e5e8ed; }
.profile-account-row { display: flex; align-items: center; justify-content: space-between; min-height: 90rpx; padding: 0 28rpx; font-size: 27rpx; border-bottom: 1rpx solid #e5e8ed; }
.profile-account-row:last-child { border-bottom: 0; }
.profile-account-row text:first-child { color: #687283; }
.profile-account-row text:last-child { color: #20242b; font-weight: 650; }
.profile-account-row text.is-normal { color: #35805d; }
.profile-logout-button { height: 88rpx; margin-top: 36rpx; color: #d84f51; font-size: 28rpx; font-weight: 700; line-height: 88rpx; background: #fff; border: 1rpx solid #f1c4c5; border-radius: 14rpx; }
.action-layer { position: fixed; inset: 0; z-index: 50; display: flex; align-items: flex-end; padding: 20rpx; background: rgba(24,31,39,.46); }
.action-sheet { width: 100%; }
.action-sheet button { height: 96rpx; color: #20242b; font-size: 30rpx; line-height: 96rpx; background: #fff; border-radius: 0; }
.action-sheet button:first-child { border-radius: 18rpx 18rpx 0 0; }
.action-sheet button:nth-child(2) { border-top: 1rpx solid #e5e8ed; border-radius: 0 0 18rpx 18rpx; }
.action-sheet button.action-cancel { margin-top: 16rpx; border-radius: 18rpx; }
