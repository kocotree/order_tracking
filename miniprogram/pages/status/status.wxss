.status-page { display: flex; min-height: 100vh; flex-direction: column; align-items: center; padding: 120rpx 38rpx 60rpx; color: #20242b; background: linear-gradient(180deg,#f8fbfd,#eef5f9); }
.status-brand { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-bottom: 64rpx; color: #687283; font-size: 24rpx; }
.status-brand text:first-child { color: #173f5f; font-size: 34rpx; font-weight: 800; letter-spacing: 4rpx; }
.status-card { display: flex; width: 100%; flex-direction: column; align-items: center; padding: 54rpx 42rpx; background: #fff; border: 1rpx solid #d2d7df; border-radius: 20rpx; box-shadow: 0 24rpx 60rpx rgba(42,61,78,.1); }
.status-mark { display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; margin-bottom: 30rpx; color: #a76c07; font-size: 38rpx; font-weight: 750; background: #fff6df; border-radius: 50%; }
.status-rejected .status-mark { color: #d84f51; background: #fff0f0; }
.status-disabled .status-mark, .status-logged-out .status-mark { color: #67717e; background: #eef1f4; }
.status-eyebrow { margin-bottom: 14rpx; color: #087fd1; font-size: 22rpx; font-weight: 700; letter-spacing: 4rpx; }
.status-title { font-size: 40rpx; font-weight: 750; }
.status-description, .status-reason { margin-top: 24rpx; color: #687283; font-size: 26rpx; line-height: 1.7; text-align: center; }
.status-reason { color: #d84f51; }
.status-note { width: 100%; margin-top: 36rpx; padding: 22rpx; color: #a76c07; font-size: 24rpx; text-align: center; background: #fff6df; border-radius: 12rpx; }
.status-button { width: 100%; height: 88rpx; margin-top: 32rpx; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 88rpx; background: #0d8fe9; border-radius: 12rpx; }
