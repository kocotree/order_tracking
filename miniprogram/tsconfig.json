{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["miniprogram-api-typings", "vitest/globals"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "app.ts",
    "api/**/*.ts",
    "components/**/*.ts",
    "modules/**/*.ts",
    "pages/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts"
  ]
}
